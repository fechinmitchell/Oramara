# oramara/.env.example
# Copy this file to .env (in the same folder) and fill in your own values.
# The .env file stays on your computer and is never added to GitHub.

# Long random secret that signs every login. Make one in Terminal with:
#   openssl rand -hex 48
# then paste the result here in place of the placeholder.
JWT_SECRET=paste_a_long_random_secret_here

# Your admin login. The password needs at least 10 characters.
# It is only used the first time; after that change it in the admin under Account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_NAME=

# Websites allowed to use the backend. Leave as is for your own computer.
CORS_ORIGINS=http://localhost:5173
PORTAL_URL=http://localhost:5173

# Claude writes the pitch reports and finds contacts. Leave empty to turn this off.
ANTHROPIC_API_KEY=

# Copernicus Data Space keys for the free Sentinel 2 satellite data. Leave empty to turn this off.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional: contact email sent with OpenStreetMap lookups (they ask for one)
OSM_CONTACT_EMAIL=

# DATABASE_URL is set for you in docker-compose.yml, so you do not need it here.
# When the backend moves to Render, Render fills DATABASE_URL in itself.
